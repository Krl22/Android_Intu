rules_version = '2';
// Firestore ya no guarda datos de Intu: todo vive en Supabase. La app solo lee el perfil antiguo
// del propio usuario para copiarlo una vez a Supabase, y luego lo borra. Todo lo demás queda cerrado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
