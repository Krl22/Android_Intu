<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos necesarios para Mapbox -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Conductor en línea con la app en segundo plano: servicio con GPS y avisos de solicitudes -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Pasajero con un viaje abierto: la app sigue al día minimizada (servicio de uso especial) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Conductor: saber si tiene Google Maps o Waze instalados para navegar hasta el recojo o el destino -->
    <queries>
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.waze" />
    </queries>

    <application
        android:name=".IntuApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Intu">
        <!-- Mantiene al conductor en línea (GPS y solicitudes) aunque la app esté minimizada -->
        <service
            android:name=".driver.DriverOnlineService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Pasajero con un viaje abierto: mantiene al día el viaje, la ruta y el mapa con la app minimizada -->
        <service
            android:name=".rider.RideTrackingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Seguimiento en vivo del viaje que pidió el pasajero: estado, ubicación del conductor y ruta" />
        </service>

        <!-- Avisos push del viaje (FCM). Con la app minimizada Android los muestra con este canal e ícono -->
        <service
            android:name=".push.IntuMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="ride_updates" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_intu" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/intu_teal" />

        <!-- Permite a la app de cámara guardar la foto de perfil en la caché privada de Intu -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Intu.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>